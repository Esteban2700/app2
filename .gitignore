```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/
*.js
*.css
*.html

# Environment variables
.env
.env.local
*.env.*

# Editors and IDEs
.vscode/
.idea/

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*.swo

# Coverage reports
coverage/
htmlcov/
.coverage

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Node.js specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Distribution / packaging
*.tar.gz
*.zip
*.tgz

# Compiled Binary Files
*.exe
*.dll
*.so
*.a
*.obj
*.out

# Java specific
*.class
target/

# Go specific
*.out

# Rust specific
target/

# Gradle
.gradle/

# Compressed files
*.gz
*.tar
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```